{
  "name": "oluwatimilehin/spotify-music-api",
  "description": "A PHP SDK wrapper for the Spotify Web API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tawose Oluwatimilehin",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0"
  },
  "autoload": {
    "psr-4": {
      "SpotifyMusicApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SpotifyMusicApi\\Tests\\": "Tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
